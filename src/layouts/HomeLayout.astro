---
import { getCollection } from "astro:content";
import Layout from "./Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import Hr from "@components/Hr.astro";
import Card from "@components/Card";
import getSortedPosts from "@utils/getSortedPosts";

export interface Props {
  frontmatter: {
    tagline: string;
    title: string;
  };
}

const { frontmatter } = Astro.props;

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main id="main-content">
    <section id="hero" class="hum-reveal">
      <div class="hero-titles">
        <p class="hero-tag mono-label">{frontmatter.tagline}</p>
        <h1>{frontmatter.title}</h1>
      </div>

      <div class="hero-body prose hum-stagger">
        <slot />
      </div>
    </section>

    <Hr />

    {
      featuredPosts.length > 0 && (
        <>
          <section
            id="featured"
            class="section--band hum-reveal hum-reveal-delay-2"
          >
            <h2 class="section-title">
              <span class="section-index">01</span>
              <span>Latest</span>
            </h2>
            <ul class="post-list">
              {featuredPosts.map(({ data, slug }, i) => (
                <Card
                  href={`/posts/${slug}/`}
                  frontmatter={data}
                  secHeading={false}
                  variant={i % 2 === 0 ? "pear" : "cyan"}
                />
              ))}
            </ul>
          </section>
          {recentPosts.length > 0 && <Hr />}
        </>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="hum-reveal hum-reveal-delay-3">
          <h2 class="section-title">
            <span class="section-index">02</span>
            <span>More posts</span>
          </h2>
          <ul class="post-list">
            {recentPosts.map(
              ({ data, slug }, index) =>
                index < 4 && (
                  <Card
                    href={`/posts/${slug}/`}
                    frontmatter={data}
                    secHeading={false}
                    variant={index % 2 === 0 ? "cyan" : "default"}
                  />
                )
            )}
          </ul>
        </section>
      )
    }

    <div class="all-posts-btn-wrapper hum-reveal hum-reveal-delay-3">
      <LinkButton href="/posts/" className="btn btn--cyan">
        All posts
        <svg xmlns="http://www.w3.org/2000/svg" class="btn-arrow"
          ><path
            d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z"
          ></path>
        </svg>
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  #hero {
    @apply pb-6 pt-8;
  }
  .hero-tag {
    @apply mb-1;
  }
  .hero-titles h1 {
    @apply my-1 text-4xl font-bold tracking-tight sm:text-6xl;
    font-family: var(--font-display);
    overflow-wrap: anywhere;
    min-width: 0;
  }
  .hero-body {
    @apply prose-p:my-2 prose-p:leading-relaxed;
  }

  .section-title {
    @apply mb-6 flex flex-wrap items-baseline gap-x-2 gap-y-1 text-2xl font-semibold tracking-tight;
    font-family: var(--font-display);
  }

  .section-title .section-index {
    font-family: var(--font-label);
    font-size: 1em;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-kicker);
  }

  .section-title .section-index::after {
    content: "·";
    margin-left: 0.35em;
    color: var(--color-ink-2);
    font-weight: 400;
  }

  .post-list {
    @apply list-none pl-0;
  }

  #featured,
  #recent-posts {
    @apply pb-6 pt-8;
  }

  .all-posts-btn-wrapper {
    @apply my-10 text-center;
  }

  .btn-arrow {
    @apply h-5 w-5 fill-current;
  }
</style>
