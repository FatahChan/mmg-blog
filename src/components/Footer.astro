---
import Hr from "./Hr.astro";
import Socials from "./Socials.astro";
import { SOCIALS } from "@config";

const currentYear = new Date().getFullYear();
const hasSocials = SOCIALS.some(s => s.active);

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;

const marqueeText =
  "Hangouts · workshops · birthdays · lectures · knowledge-sharing · Cairo & beyond · ";
---

<footer class={`site-footer ${noMarginTop ? "" : "mt-auto"}`}>
  <Hr noPadding />
  <div class="footer-marquee" aria-hidden="true">
    <div class="footer-marquee__track">
      <span>{marqueeText}</span>
      <span>{marqueeText}</span>
    </div>
  </div>
  <div class="footer-wrapper">
    {hasSocials && <Socials centered />}
    <div class="copyright-wrapper">
      <span class="mono-label">Mawalid Masr Gang &copy; {currentYear}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    @apply w-full;
  }
  .footer-wrapper {
    @apply flex flex-col items-center justify-between py-4 sm:flex-row-reverse;
  }
  .link-button {
    @apply my-1 p-2 hover:rotate-6;
  }
  .link-button svg {
    @apply scale-125;
  }
  .copyright-wrapper {
    @apply my-2 flex flex-col items-center whitespace-nowrap sm:flex-row;
  }
</style>
